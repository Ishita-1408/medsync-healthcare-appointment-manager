# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Server Configuration (Never expose SERVICE_ROLE_KEY to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# AI / LLM Configuration (Phase 2 & 3)
OPENAI_API_KEY=your-openai-api-key-optional
GEMINI_API_KEY=your-gemini-api-key-optional

# Email Delivery Configuration (Phase 4)
RESEND_API_KEY=your-resend-api-key-optional
EMAIL_FROM="MedSync Health <notifications@medsync.health>"
APP_URL=http://localhost:5173


# Google Calendar OAuth 2.0 Configuration (Phase 5)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/auth/callback
